# Copy to .env — NEVER commit real keys.
# (Prisma's CLI reads .env, not .env.local; Next.js reads both, with
# .env.local overriding .env if you also use one for secrets.)
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SaaS Starter"

# Database — PostgreSQL (Supabase is the recommended free host).
# Set this to your Postgres connection string, then run
# `npx prisma generate` and `npm run db:push`. Never commit a
# production DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/saas_starter"

# Auth — Auth.js (NextAuth v5). See src/auth.ts and README § Auth.
# AUTH_SECRET signs the session JWT. Generate a long random value and
# keep it secret, e.g. `openssl rand -base64 32`. The app will not
# sign users in correctly if this is empty or shared between apps.
AUTH_SECRET=change-me-to-a-long-random-string

# Google sign-in (optional). Create an OAuth client in Google Cloud
# Console (APIs & Services → Credentials → OAuth client ID, web
# application) and paste the ID and secret here. The authorized
# redirect URI is <NEXT_PUBLIC_APP_URL>/api/auth/callback/google.
# Without these, the "Continue with Google" button is hidden and
# the Google provider is not registered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Billing — Polar (merchant of record). See README § Billing.
# Create the product in Polar first, then paste the IDs here.
# No keys are hard-coded anywhere in this codebase.
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=669ea722-a0ce-497f-8546-70a4a54a6354
POLAR_PRODUCT_ID_STARTER=066c0b11-a723-4644-865d-3a6befb157a7
POLAR_PRODUCT_ID_PRO=bf1d9cff-9d4c-4477-9158-404f98768f39
POLAR_WEBHOOK_SECRET=
NEXT_PUBLIC_POLAR_CHECKOUT_URL=

# Billing — Stripe (optional second checkout option). See README § Billing.
# Only the two keys are needed: checkout uses inline price_data, so no
# Stripe products have to be pre-created. Without these, Stripe
# checkout returns a clear "not configured" error and Polar stays
# the only option.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — Resend (optional, but needed for magic links, password
# reset and the signup verification email). See README § Email.
# One key powers everything email in the kit. Without it, auth keeps
# working and the email steps report "not configured" instead of
# crashing. EMAIL_FROM is the sender shown on outgoing mail; the
# default is Resend's test sender — use your own verified domain
# for real mail (see README § Email).
RESEND_API_KEY=
EMAIL_FROM="SaaS Starter <onboarding@resend.dev>"

# Fallback billing — Paddle (merchant of record). Only needed if Polar
# is unavailable for your product. See README § Billing.
# PADDLE_API_KEY=
# PADDLE_PRODUCT_ID_PRO=
