# Copy to .env — NEVER commit real keys.
# (Prisma's CLI reads .env, not .env.local; Next.js reads both, with
# .env.local overriding .env if you also use one for secrets.)
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SaaS Starter"

# Database — SQLite by default, works out of the box (no cloud account).
# The file is created by `npm run db:setup`. For production Postgres
# (Supabase is the recommended free host), set this to your Postgres
# connection string and use prisma/schema.postgres.prisma (see README
# § Database). Never commit a production DATABASE_URL.
DATABASE_URL="file:./dev.db"

# Auth — Auth.js (NextAuth v5), credentials provider (see src/auth.ts).
# AUTH_SECRET signs the session JWT. Generate a long random value and
# keep it secret, e.g. `openssl rand -base64 32`. The app will not
# sign users in correctly if this is empty or shared between apps.
AUTH_SECRET=change-me-to-a-long-random-string

# Billing — Polar (merchant of record). See README § Billing.
# Create the product in Polar first, then paste the IDs here.
# No keys are hard-coded anywhere in this codebase.
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=669ea722-a0ce-497f-8546-70a4a54a6354
POLAR_PRODUCT_ID_STARTER=066c0b11-a723-4644-865d-3a6befb157a7
POLAR_PRODUCT_ID_PRO=bf1d9cff-9d4c-4477-9158-404f98768f39
POLAR_WEBHOOK_SECRET=
NEXT_PUBLIC_POLAR_CHECKOUT_URL=

# Fallback billing — Paddle (merchant of record). Only needed if Polar
# is unavailable for your product. See README § Billing.
# PADDLE_API_KEY=
# PADDLE_PRODUCT_ID_PRO=
